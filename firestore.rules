rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Permitted V3 collections for synthetic demo prototype (requires authentication)
    match /customers/{docId} {
      allow read, write: if request.auth != null;
    }
    match /accounts/{docId} {
      allow read, write: if request.auth != null;
    }
    match /transactions/{docId} {
      allow read, write: if request.auth != null;
    }
    match /devices/{docId} {
      allow read, write: if request.auth != null;
    }
    match /login_events/{docId} {
      allow read, write: if request.auth != null;
    }
    match /merchants/{docId} {
      allow read, write: if request.auth != null;
    }
    match /network_signals/{docId} {
      allow read, write: if request.auth != null;
    }
    match /investigations/{docId} {
      allow read, write: if request.auth != null;
    }
    match /agent_logs/{docId} {
      allow read, write: if request.auth != null;
    }
    match /evidence/{docId} {
      allow read, write: if request.auth != null;
    }
    match /correlations/{docId} {
      allow read, write: if request.auth != null;
    }
    match /cases/{docId} {
      allow read, write: if request.auth != null;
    }
    match /case_notes/{docId} {
      allow read, write: if request.auth != null;
    }
    match /feedback/{docId} {
      allow read, write: if request.auth != null;
    }
    match /scenario_runs/{docId} {
      allow read, write: if request.auth != null;
    }
    match /system_metrics/{docId} {
      allow read, write: if request.auth != null;
    }

    // Audit logs MUST be append-only: create and read permitted, update and delete strictly prohibited
    match /audit_logs/{docId} {
      allow read, create: if request.auth != null;
      allow update, delete: if false;
    }

    // Phase 2.6 Patch & Phase 5 Security Hardening: Notifications collection with strict customer isolation & ownership enforcement
    match /notifications/{notificationId} {
      // Authenticated users only. Must supply required audit fields and prove caller ownership
      allow create: if request.auth != null
        && request.resource.data.customer_id != null
        && request.resource.data.account_id != null
        && request.resource.data.device_id != null
        && (
          (request.resource.data.auth_uid != null && request.resource.data.auth_uid == request.auth.uid)
          || (exists(/databases/$(database)/documents/devices/$(request.auth.uid))
              && get(/databases/$(database)/documents/devices/$(request.auth.uid)).data.customer_id == request.resource.data.customer_id)
          || (exists(/databases/$(database)/documents/devices/$(request.resource.data.device_id))
              && get(/databases/$(database)/documents/devices/$(request.resource.data.device_id)).data.firebaseUid == request.auth.uid)
        );

      // Ownership enforcement:
      // Read permitted only if caller is authenticated and notification belongs to caller's registered device/customer session or auth UID
      allow read: if request.auth != null
        && (
          (exists(/databases/$(database)/documents/devices/$(request.auth.uid))
           && get(/databases/$(database)/documents/devices/$(request.auth.uid)).data.customer_id == resource.data.customer_id)
          || (resource.data.auth_uid != null && resource.data.auth_uid == request.auth.uid)
          || (resource.data.device_id != null
              && exists(/databases/$(database)/documents/devices/$(resource.data.device_id))
              && get(/databases/$(database)/documents/devices/$(resource.data.device_id)).data.firebaseUid == request.auth.uid)
        );

      // Update permitted only on own notifications; customer_id, account_id, device_id, and auth_uid are strictly immutable
      allow update: if request.auth != null
        && (
          (exists(/databases/$(database)/documents/devices/$(request.auth.uid))
           && get(/databases/$(database)/documents/devices/$(request.auth.uid)).data.customer_id == resource.data.customer_id)
          || (resource.data.auth_uid != null && resource.data.auth_uid == request.auth.uid)
          || (resource.data.device_id != null
              && exists(/databases/$(database)/documents/devices/$(resource.data.device_id))
              && get(/databases/$(database)/documents/devices/$(resource.data.device_id)).data.firebaseUid == request.auth.uid)
        )
        && request.resource.data.customer_id == resource.data.customer_id
        && request.resource.data.account_id == resource.data.account_id
        && request.resource.data.device_id == resource.data.device_id
        && (!('auth_uid' in resource.data) || request.resource.data.auth_uid == resource.data.auth_uid);

      // Deletion strictly prohibited
      allow delete: if false;
    }

    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
